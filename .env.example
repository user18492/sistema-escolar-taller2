# Configuración de conexión a PostgreSQL (desarrollo local).
# Copiar este archivo como .env y ajustar los valores si hiciera falta.
# Lo usan db/setup-db.ps1 y el proceso principal de la aplicación.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=sistema-escolar-taller2-db
DB_USER=postgres
DB_PASSWORD=admin
